# Copy this file to .env and fill it in. NEVER commit .env to GitHub.
PORT=3000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Email delivery (used when an applicant picks "Email"). Applications go to MAIL_TO.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=a 16-character Google App Password (not your normal password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
TIMEZONE=Africa/Lusaka
# Optional: your own web address, used in receipt links. If empty, the address the admin is using is used.
PUBLIC_URL=
